# Backend only — copy to .env and fill in values.
OPENAI_API_KEY=

# PostgreSQL connection string (Supabase). Use the pooled "Transaction" connection
# string from Supabase → Project Settings → Database → Connection string, and add
# ?pgbouncer=true (Supabase's pooler requires it for Prisma).
# Local dev example (Homebrew Postgres): postgresql://localhost:5432/elk_garden_dev?schema=public
DATABASE_URL=

# API listen port (optional; default 8788)
ELK_API_PORT=8788

# Optional: override port (used if set)
# PORT=8788

# Optional CORS
# CORS_ORIGIN=http://localhost:5173
