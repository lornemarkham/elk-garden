# Backend only — copy to .env and fill in values.
OPENAI_API_KEY=

# Runtime Prisma Client (pooled). Supabase → Database → Connection string →
# Transaction pooler (port 6543). Append ?pgbouncer=true.
# Local Homebrew Postgres example:
# DATABASE_URL="postgresql://localhost:5432/elk_garden_dev?schema=public"
DATABASE_URL=

# Prisma CLI / migrate deploy (direct or session mode). Supabase → Database →
# Connection string → Session pooler OR Direct (port 5432). Do NOT use
# transaction pooler / pgbouncer here — migrations will fail and tables won't
# be created.
# Local: can be the same as DATABASE_URL.
DIRECT_URL=

# API listen port (optional; default 8788)
ELK_API_PORT=8788

# Optional: override port (used if set)
# PORT=8788

# Optional CORS
# CORS_ORIGIN=http://localhost:5173
